{
  "name": "jarvis-desktop",
  "productName": "JARVIS",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS desktop shell (Phase 6.1 foundation). Renderer has no network access; all backend calls run in the Electron main process.",
  "main": "dist/electron/main/main.js",
  "type": "commonjs",
  "scripts": {
    "generate:api": "node scripts/generate-api.mjs",
    "dev:renderer": "vite",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "typecheck": "npm run typecheck:main && npm run typecheck:node && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:run": "node --test \"dist-test/tests/*.test.js\"",
    "test": "npm run build:main && npm run test:compile && npm run test:run",
    "voice:download": "node scripts/voice-smoke.mjs --download-only",
    "voice:smoke": "node scripts/voice-smoke.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sherpa-onnx-node": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.4.11",
    "openapi-typescript": "7.5.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.19"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
