# JARVIS Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=JARVIS
APP_VERSION=0.1.0
APP_ENV=development

# Server
# The backend rejects non-loopback host values.
HOST=127.0.0.1
PORT=8000

# Local API security
# Generate a high-entropy value; never commit it or place it in a URL.
JARVIS_API_TOKEN=
# Optional exact browser origins, comma-separated. Native clients send no Origin.
JARVIS_ALLOWED_ORIGINS=
# Optional absolute path to a trusted VS Code executable.
JARVIS_CODE_EXECUTABLE=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# LLM provider selection: fake | gemini | ollama
# fake   = deterministic offline default (no network, always works)
# gemini = live cloud generation (requires GEMINI_API_KEY)
# ollama = local model via the Ollama runtime (see Ollama section below)
LLM_PROVIDER=ollama
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=

# Ollama local provider (Phase 1 - text generation only)
# Requires a local Ollama install; see README "Ollama (local Qwen 3.5)".
# Loopback-only: the backend rejects non-loopback OLLAMA_BASE_URL values
# so prompts can never be silently sent to arbitrary remote hosts.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Phase 1 model: Qwen 3.5 4B at the Q4_K_M quantization (~3.3 GB).
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Bounded request timeout in seconds (1.0 - 600.0).
OLLAMA_TIMEOUT_SECONDS=120
# Context window in tokens (256 - 32768). Larger windows use more
# memory; 4096 is the Phase 1 setting pending benchmarks.
OLLAMA_NUM_CTX=4096

# Execution reliability (Phase 4.3)
# SQLite file that keeps plans, approval records, execution attempts,
# and audit events durable across restarts. Default when unset:
# backend/data/jarvis_state.db (gitignored). Always local, never
# contains secrets or model instructions.
JARVIS_STATE_DB_PATH=
# Tool execution timeout: a bounded wall-clock budget per tool call,
# separate from provider timeouts (0.05 - 120 seconds). A mutating tool
# that times out is treated as an uncertain outcome, never retried.
TOOL_TIMEOUT_SECONDS=20
