# JARVIS Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=JARVIS
APP_VERSION=0.1.0
APP_ENV=development

# Server
# The backend rejects non-loopback host values.
HOST=127.0.0.1
PORT=8000

# Local API security
# Generate a high-entropy value; never commit it or place it in a URL.
JARVIS_API_TOKEN=
# Optional exact browser origins, comma-separated. Native clients send no Origin.
JARVIS_ALLOWED_ORIGINS=
# Optional absolute path to a trusted VS Code executable.
JARVIS_CODE_EXECUTABLE=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# LLM provider (fake = deterministic offline default, gemini = live API)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
